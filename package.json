{
  "name": "@chabdulwahab/api-spy",
  "version": "1.0.2",
  "description": "Zero-dependency, high-performance Express.js middleware terminal dashboard",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/cjs/index.d.ts"
    }
  },
  "scripts": {
    "build": "node build.js"
  },
  "keywords": [
    "express",
    "middleware",
    "apm",
    "logging",
    "dashboard",
    "terminal",
    "performance"
  ],
  "author": "Ch Abdul Wahhab",
  "license": "MIT",
  "dependencies": {
    "@chabdulwahab/api-spy": "^1.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "express": "^4.19.2",
    "typescript": "^5.3.3"
  }
}
